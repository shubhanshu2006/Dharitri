generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectType {
  HIGHWAY
  RAILWAY
  INDUSTRIAL_CORRIDOR
  IRRIGATION
  URBAN_DEVELOPMENT
  RENEWABLE_ENERGY
  STRATEGIC_INFRASTRUCTURE
  OTHER
}

enum ScopeLevel {
  NATIONAL
  STATE
  DISTRICT
  PROJECT
  ASSIGNED_CASE
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  PASS
  FAIL
  WARNING
  APPROVED
  REQUIRES_CORRECTION
}

enum AcquisitionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFICATION_PENDING
  VERIFIED
  ACQUISITION_INITIATED
  NOTIFICATION_STAGE
  AWARD_STAGE
  ACQUISITION_COMPLETED
  ON_HOLD
  CANCELLED
}

enum CompensationStatus {
  DRAFT
  UNDER_REVIEW
  CORRECTION_REQUIRED
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  NOT_INITIATED
  INITIATED
  PROCESSING
  CREDITED
  FAILED
  RETURNED
  REJECTED
  CORRECTION_REQUIRED
}

enum BeneficiaryVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REQUIRES_CORRECTION
}

enum RRStatus {
  NOT_STARTED
  APPLICABILITY_REVIEW
  ASSESSMENT
  APPROVAL_PENDING
  APPROVED
  PROVISION_IN_PROGRESS
  FIELD_VERIFICATION
  COMPLETED
  DISPUTED
  ON_HOLD
}

enum PossessionStatus {
  PENDING
  NOTICE_ISSUED
  READY
  RECORDED
  DISPUTED
  REJECTED
}

enum DocumentStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  RESTRICTED
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  INSUFFICIENT_DATA
}

enum FieldVisitStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  REQUIRES_CORRECTION
}

enum ChecklistStatus {
  PENDING
  PASS
  FAIL
  NOT_APPLICABLE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IntegrationSyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum GrievanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum DepartmentType {
  MINISTRY
  STATE_DEPARTMENT
  DISTRICT_OFFICE
  IMPLEMENTING_AGENCY
  OTHER
}

enum WorkflowEntityType {
  PROJECT
  ACQUISITION_CASE
  COMPENSATION
  PAYMENT
  BENEFICIARY
  RR_CASE
  POSSESSION
}

enum RiskEntityType {
  PROJECT
  ACQUISITION_PARCEL
  ACQUISITION_CASE
  COMPENSATION
  PAYMENT
  RR_CASE
}

enum DocumentAccessClass {
  PUBLIC
  INTERNAL
  RESTRICTED
  SENSITIVE
}

model State {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  districts   District[]
  projects    Project[]
  parcels     CadastralParcel[]
  scopes      UserScope[]
  departments Department[]

  @@index([name])
}

model District {
  id        String   @id @default(uuid()) @db.Uuid
  stateId   String   @db.Uuid
  code      String   @db.VarChar(32)
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  state       State             @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tehsils     Tehsil[]
  projects    Project[]
  parcels     CadastralParcel[]
  scopes      UserScope[]
  departments Department[]

  @@unique([stateId, code])
  @@index([stateId])
  @@index([name])
}

model Tehsil {
  id         String   @id @default(uuid()) @db.Uuid
  districtId String   @db.Uuid
  code       String   @db.VarChar(32)
  name       String   @db.VarChar(160)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  district District          @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  villages Village[]
  parcels  CadastralParcel[]

  @@unique([districtId, code])
  @@index([districtId])
  @@index([name])
}

model Village {
  id        String   @id @default(uuid()) @db.Uuid
  tehsilId  String   @db.Uuid
  code      String   @db.VarChar(32)
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tehsil  Tehsil            @relation(fields: [tehsilId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parcels CadastralParcel[]

  @@unique([tehsilId, code])
  @@index([tehsilId])
  @@index([name])
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique @db.VarChar(255)
  name        String   @db.VarChar(200)
  email       String   @db.VarChar(320)
  phone       String?  @db.VarChar(32)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  roles                      UserRole[]
  scopes                     UserScope[]
  projectMembers             ProjectMember[]
  assignedAcquisitions       AcquisitionCase[]          @relation("AcquisitionAssignee")
  assignedAcquisitionParcels AcquisitionParcel[]        @relation("AcquisitionParcelAssignee")
  verificationAssignments    VerificationCase[]         @relation("VerificationAssignee")
  fieldVisits                FieldVisit[]
  notifications              Notification[]
  auditEvents                AuditEvent[]               @relation("AuditActor")
  resolvedAlerts             Alert[]                    @relation("AlertResolver")
  resolvedAnomalies          AnomalyEvent[]             @relation("AnomalyResolver")
  resolvedGrievances         Grievance[]                @relation("GrievanceResolver")
  assignedGrievances         Grievance[]                @relation("GrievanceAssignee")
  createdProjects            Project[]                  @relation("ProjectCreator")
  compensationAssessments    CompensationAssessment[]   @relation("CompensationAssessor")
  compensationApprovals      CompensationAssessment[]   @relation("CompensationApprover")
  compensationAwards         CompensationAward[]        @relation("AwardApprover")
  possessionRecords          PossessionRecord[]         @relation("PossessionRecorder")
  possessionChecklistItems   PossessionChecklistItem[]  @relation("PossessionChecklistCompleter")
  documentVersions           DocumentVersion[]          @relation("DocumentVersionUploader")
  documents                  Document[]                 @relation("DocumentUploader")
  workflowTransitions        WorkflowTransitionRecord[] @relation("WorkflowActor")
  rrCasesApproved            RRCase[]                   @relation("RRApprover")
  rrCasesCompleted           RRCase[]                   @relation("RRCompleter")
  beneficiariesCreated       Beneficiary[]              @relation("BeneficiaryCreator")
  grievanceSubmissions       Grievance[]                @relation("GrievanceSubmitter")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(160)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserScope {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  scopeLevel     ScopeLevel
  stateId        String?    @db.Uuid
  districtId     String?    @db.Uuid
  projectId      String?    @db.Uuid
  assignedCaseId String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state    State?    @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([scopeLevel])
  @@index([stateId])
  @@index([districtId])
  @@index([projectId])
  @@index([assignedCaseId])
}

model Department {
  id         String         @id @default(uuid()) @db.Uuid
  name       String         @db.VarChar(200)
  code       String         @unique @db.VarChar(64)
  type       DepartmentType
  stateId    String?        @db.Uuid
  districtId String?        @db.Uuid
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(6)

  state              State?    @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district           District? @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectsAsAgency   Project[] @relation("ImplementingAgency")
  projectsAsMinistry Project[] @relation("Ministry")
}

model Project {
  id                   String        @id @default(uuid()) @db.Uuid
  projectCode          String        @unique @db.VarChar(64)
  name                 String        @db.VarChar(240)
  projectType          ProjectType
  description          String?       @db.Text
  status               ProjectStatus @default(DRAFT)
  implementingAgencyId String?       @db.Uuid
  ministryId           String?       @db.Uuid
  stateId              String        @db.Uuid
  districtId           String?       @db.Uuid
  createdById          String        @db.Uuid
  createdAt            DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(6)

  implementingAgency Department? @relation("ImplementingAgency", fields: [implementingAgencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ministry           Department? @relation("Ministry", fields: [ministryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  state              State       @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district           District?   @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy          User        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  boundary           ProjectBoundary?
  milestones         ProjectMilestone[]
  members            ProjectMember[]
  landRequirements   LandRequirement[]
  acquisitionParcels AcquisitionParcel[]
  scopes             UserScope[]
  rrCases            RRCase[]
  fieldVisits        FieldVisit[]
  alerts             Alert[]
  grievances         Grievance[]

  @@index([status])
  @@index([stateId])
  @@index([districtId])
  @@index([projectType])
  @@index([createdAt])
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectBoundary {
  id             String                   @id @default(uuid()) @db.Uuid
  projectId      String                   @unique @db.Uuid
  sourceType     String                   @db.VarChar(64)
  sourceSystem   String?                  @db.VarChar(120)
  sourceRecordId String?                  @db.VarChar(255)
  geometry       Unsupported("geometry")?
  srid           Int
  areaSqMeters   Decimal                  @db.Decimal(18, 4)
  geometryHash   String?                  @db.VarChar(128)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sourceSystem, sourceRecordId])
}

model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  name        String    @db.VarChar(160)
  description String?   @db.Text
  dueDate     DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  status      String    @db.VarChar(64)
  sequence    Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId, status])
  @@index([projectId, dueDate])
}

model LandRequirement {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  requiredAreaSqMeters Decimal  @db.Decimal(18, 4)
  landCategory         String?  @db.VarChar(120)
  description          String?  @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([projectId])
}

model CadastralParcel {
  id                String                   @id @default(uuid()) @db.Uuid
  parcelReference   String                   @unique @db.VarChar(160)
  ulpin             String?                  @db.VarChar(128)
  surveyNumber      String?                  @db.VarChar(128)
  subDivisionNumber String?                  @db.VarChar(128)
  stateId           String                   @db.Uuid
  districtId        String                   @db.Uuid
  tehsilId          String?                  @db.Uuid
  villageId         String?                  @db.Uuid
  areaSqMeters      Decimal                  @db.Decimal(18, 4)
  landCategory      String?                  @db.VarChar(120)
  geometrySourceId  String?                  @db.Uuid
  geometry          Unsupported("geometry")?
  sourceSystem      String?                  @db.VarChar(120)
  sourceRecordId    String?                  @db.VarChar(255)
  sourceRetrievedAt DateTime?                @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)

  state              State                  @relation(fields: [stateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district           District               @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tehsil             Tehsil?                @relation(fields: [tehsilId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  village            Village?               @relation(fields: [villageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  geometrySource     ParcelGeometrySource?  @relation("CurrentGeometrySource", fields: [geometrySourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  geometrySources    ParcelGeometrySource[] @relation("ParcelGeometryHistory")
  landRecords        LandRecordReference[]
  acquisitionParcels AcquisitionParcel[]

  @@index([ulpin])
  @@index([surveyNumber])
  @@index([villageId])
  @@index([districtId])
  @@index([sourceSystem, sourceRecordId])
}

model ParcelGeometrySource {
  id                String                   @id @default(uuid()) @db.Uuid
  cadastralParcelId String                   @db.Uuid
  sourceSystem      String                   @db.VarChar(120)
  sourceRecordId    String                   @db.VarChar(255)
  geometry          Unsupported("geometry")?
  srid              Int
  retrievedAt       DateTime                 @db.Timestamptz(6)
  isCurrent         Boolean                  @default(false)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)

  cadastralParcel CadastralParcel   @relation("ParcelGeometryHistory", fields: [cadastralParcelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentFor      CadastralParcel[] @relation("CurrentGeometrySource")

  @@index([cadastralParcelId, isCurrent])
  @@index([sourceSystem, sourceRecordId])
}

model LandRecordReference {
  id                String   @id @default(uuid()) @db.Uuid
  cadastralParcelId String   @db.Uuid
  sourceSystem      String   @db.VarChar(120)
  sourceRecordId    String   @db.VarChar(255)
  parcelReference   String   @db.VarChar(160)
  surveyNumber      String?  @db.VarChar(128)
  ulpin             String?  @db.VarChar(128)
  recordStatus      String?  @db.VarChar(80)
  recordVersion     String?  @db.VarChar(80)
  retrievedAt       DateTime @db.Timestamptz(6)
  rawPayloadHash    String?  @db.VarChar(128)
  normalizedPayload Json
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  cadastralParcel CadastralParcel @relation(fields: [cadastralParcelId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sourceSystem, sourceRecordId])
  @@index([cadastralParcelId])
  @@index([ulpin])
}

model AcquisitionParcel {
  id                   String                   @id @default(uuid()) @db.Uuid
  projectId            String                   @db.Uuid
  cadastralParcelId    String                   @db.Uuid
  acquisitionReference String                   @unique @db.VarChar(160)
  requiredAreaSqMeters Decimal                  @db.Decimal(18, 4)
  acquisitionGeometry  Unsupported("geometry")?
  geometryAreaSqMeters Decimal?                 @db.Decimal(18, 4)
  landCategory         String?                  @db.VarChar(120)
  status               AcquisitionStatus        @default(DRAFT)
  currentAssigneeId    String?                  @db.Uuid
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(6)

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cadastralParcel CadastralParcel  @relation(fields: [cadastralParcelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentAssignee User?            @relation("AcquisitionParcelAssignee", fields: [currentAssigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acquisitionCase AcquisitionCase?

  @@unique([projectId, cadastralParcelId, acquisitionReference])
  @@index([projectId])
  @@index([cadastralParcelId])
  @@index([status])
  @@index([createdAt])
}

model AcquisitionCase {
  id                  String            @id @default(uuid()) @db.Uuid
  acquisitionParcelId String            @unique @db.Uuid
  status              AcquisitionStatus @default(DRAFT)
  currentAssigneeId   String?           @db.Uuid
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  acquisitionParcel AcquisitionParcel @relation(fields: [acquisitionParcelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentAssignee   User?             @relation("AcquisitionAssignee", fields: [currentAssigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  verificationCases       VerificationCase[]
  compensationAssessments CompensationAssessment[]
  paymentTransactions     PaymentTransaction[]
  rrCases                 RRCase[]
  possessionRecords       PossessionRecord[]
  fieldVisits             FieldVisit[]
  alerts                  Alert[]
  grievances              Grievance[]

  @@index([status])
  @@index([currentAssigneeId])
}

model VerificationCase {
  id                String             @id @default(uuid()) @db.Uuid
  acquisitionCaseId String             @db.Uuid
  status            VerificationStatus @default(PENDING)
  startedAt         DateTime?          @db.Timestamptz(6)
  completedAt       DateTime?          @db.Timestamptz(6)
  assignedUserId    String?            @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)

  acquisitionCase AcquisitionCase      @relation(fields: [acquisitionCaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedUser    User?                @relation("VerificationAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  results         VerificationResult[]

  @@index([acquisitionCaseId])
  @@index([status])
  @@index([assignedUserId])
}

model VerificationResult {
  id                 String             @id @default(uuid()) @db.Uuid
  verificationCaseId String             @db.Uuid
  checkName          String             @db.VarChar(160)
  status             VerificationStatus
  severity           String?            @db.VarChar(40)
  source             String             @db.VarChar(120)
  message            String             @db.Text
  evidenceDocumentId String?            @db.Uuid
  checkedAt          DateTime           @db.Timestamptz(6)
  ruleVersion        String             @db.VarChar(80)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)

  verificationCase VerificationCase @relation(fields: [verificationCaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidenceDocument Document?        @relation("VerificationEvidence", fields: [evidenceDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([verificationCaseId])
  @@index([status])
  @@index([severity])
}

model WorkflowDefinition {
  id         String             @id @default(uuid()) @db.Uuid
  entityType WorkflowEntityType
  name       String             @db.VarChar(160)
  version    Int
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)

  states      WorkflowState[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@unique([entityType, version])
}

model WorkflowState {
  id                   String  @id @default(uuid()) @db.Uuid
  workflowDefinitionId String  @db.Uuid
  code                 String  @db.VarChar(80)
  name                 String  @db.VarChar(160)
  isInitial            Boolean @default(false)
  isTerminal           Boolean @default(false)

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workflowDefinitionId, code])
}

model WorkflowTransition {
  id                   String   @id @default(uuid()) @db.Uuid
  workflowDefinitionId String   @db.Uuid
  fromState            String   @db.VarChar(80)
  toState              String   @db.VarChar(80)
  requiredPermission   String   @db.VarChar(100)
  requiresReason       Boolean  @default(false)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workflowDefinitionId, fromState, toState])
}

model WorkflowInstance {
  id                   String             @id @default(uuid()) @db.Uuid
  workflowDefinitionId String             @db.Uuid
  entityType           WorkflowEntityType
  entityId             String             @db.Uuid
