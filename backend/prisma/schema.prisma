  @@index([status])
}

model PaymentTransaction {
  id                 String        @id @default(uuid()) @db.Uuid
  awardId            String        @db.Uuid
  beneficiaryId      String        @db.Uuid
  acquisitionCaseId  String?       @db.Uuid
  amount             Decimal       @db.Decimal(20, 2)
  currency           String        @default("INR") @db.Char(3)
  status             PaymentStatus @default(NOT_INITIATED)
  externalReference  String?       @db.VarChar(255)
  provider           String        @db.VarChar(120)
  idempotencyKey     String        @unique @db.VarChar(255)
  failureReason      String?       @db.Text
  initiatedAt        DateTime?     @db.Timestamptz(6)
  creditedAt         DateTime?     @db.Timestamptz(6)
  lastProviderSyncAt DateTime?     @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)

  award           CompensationAward @relation(fields: [awardId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  beneficiary     Beneficiary       @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acquisitionCase AcquisitionCase?  @relation(fields: [acquisitionCaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([awardId])
  @@index([beneficiaryId])
  @@index([acquisitionCaseId])
  @@index([status])
  @@index([externalReference])
}

model RRCase {
  id                    String    @id @default(uuid()) @db.Uuid
  projectId             String    @db.Uuid
  acquisitionCaseId     String?   @db.Uuid
  familyId              String    @db.Uuid
