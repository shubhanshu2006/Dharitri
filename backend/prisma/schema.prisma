model Document {
  id                   String               @id @default(uuid()) @db.Uuid
  entityType           String               @db.VarChar(80)
  entityId             String               @db.Uuid
  documentType         String               @db.VarChar(120)
  title                String               @db.VarChar(240)
  status               DocumentStatus       @default(ACTIVE)
  currentVersionId     String?              @unique @db.Uuid
  accessClass          DocumentAccessClass  @default(INTERNAL)
  uploadedById         String               @db.Uuid
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)
  uploadedBy           User                 @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentVersion       DocumentVersion?     @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions             DocumentVersion[]    @relation("DocumentVersions")
  verificationEvidence VerificationResult[] @relation("VerificationEvidence")
  fieldEvidence        FieldEvidence[]

  @@index([entityType, entityId])
  @@index([documentType])
  @@index([status])
}

model DocumentVersion {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @db.Uuid
  versionNumber    Int
  objectKey        String   @db.VarChar(1024)
  originalFileName String   @db.VarChar(255)
  mimeType         String   @db.VarChar(160)
  sizeBytes        BigInt
  checksum         String   @db.VarChar(128)
  uploadedById     String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  document   Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currentFor Document? @relation("CurrentDocumentVersion")
  uploadedBy User      @relation("DocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([documentId, versionNumber])
  @@index([checksum])
}

model FieldVisit {
  id                String           @id @default(uuid()) @db.Uuid
